# Koneksi MySQL (wajib). Password harus sama dengan DB_PASSWORD di .env root jika memakai docker compose.
DATABASE_URL=mysql://root@localhost:3306/crm_engine

# Kunci penanda token login (wajib). Ganti dengan nilai acak, jangan pakai contoh ini.
JWT_SECRET=change-me

# Izinkan pendaftaran organisasi baru lewat /register. Selain "true", pendaftaran ditutup.
ALLOW_PUBLIC_REGISTRATION=true

# Port API
PORT=3000

# Origin frontend yang diizinkan, dipisah koma
CORS_ORIGINS=http://localhost:3001

# URL dasar untuk tautan file upload
DEV_BASE_URL=http://localhost:3000
