# ================================
# CRM Docker Environment Variables
# ================================
# Copy file ini ke .env dan isi nilainya sebelum menjalankan docker compose

# Database password untuk MySQL
DB_PASSWORD=password

# JWT signing secret — WAJIB diisi, dan diganti dengan nilai acak di production
JWT_SECRET=change-me-in-production

# Izinkan pendaftaran organisasi baru lewat /register.
# Setelah akun pertama dibuat, set ke false jika pendaftaran tidak dibuka untuk umum.
ALLOW_PUBLIC_REGISTRATION=true

# URL publik backend (dipakai backend untuk generate URL file upload)
API_BASE_URL=http://localhost:3000

# URL backend yang diakses browser (baked saat frontend build)
# Ganti ke domain/IP production jika deploy ke server
API_URL=http://localhost:3000
