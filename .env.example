# Konfigurasi server untuk docker compose. Instalasi lokal tidak memakai file ini.
# Salin ke .env di root project pada server, lalu ganti semua nilainya.

# Password root MySQL di dalam Docker
DB_PASSWORD=change-me

# Kunci penanda token login. Isi dengan nilai acak yang panjang.
JWT_SECRET=change-me

# Set true sementara hanya untuk membuat akun pertama lewat /register
ALLOW_PUBLIC_REGISTRATION=false

# Alamat frontend yang diizinkan, dipisah koma
#   staging    -> https://crm.hexavara.com
#   production -> https://ampro.hexavara.com
CORS_ORIGINS=https://crm.example.com

# URL publik API. Dipakai saat build frontend, jadi build ulang image jika berubah.
API_URL=https://crm.example.com

# Port di host (hanya 127.0.0.1). Harus berbeda antar environment di server yang sama.
#   staging    -> API_PORT=3000, WEB_PORT=3001, DB_PORT=3307
#   production -> API_PORT=3010, WEB_PORT=3011, DB_PORT=3317
API_PORT=3000
WEB_PORT=3001
DB_PORT=3307
