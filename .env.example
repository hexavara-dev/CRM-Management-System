# Konfigurasi server untuk docker compose. Instalasi lokal tidak memakai file ini.
# Salin ke .env di root project pada server, lalu ganti semua nilainya.

# Password root MySQL di dalam Docker
DB_PASSWORD=change-me

# Kunci penanda token login. Isi dengan nilai acak yang panjang.
JWT_SECRET=change-me

# Set true sementara hanya untuk membuat akun pertama lewat /register
ALLOW_PUBLIC_REGISTRATION=false

# Domain frontend yang diizinkan, dipisah koma
CORS_ORIGINS=https://crm.example.com

# URL publik API. Dipakai saat build frontend, jadi build ulang image jika berubah.
API_URL=https://api.example.com
