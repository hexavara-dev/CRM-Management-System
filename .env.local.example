# Konfigurasi docker compose untuk komputer lokal. Salin ke .env di root project.
# Jangan dipakai di server. Untuk server, gunakan .env.example.

DB_PASSWORD=password
DB_PORT=3307
JWT_SECRET=local-docker-only-secret
ALLOW_PUBLIC_REGISTRATION=true
CORS_ORIGINS=http://localhost:3001
API_URL=http://localhost:3000
